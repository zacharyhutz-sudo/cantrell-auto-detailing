---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Interior Detailing | Cantrell Auto Detailing">
	<Header />
	<main>
		<!-- Page Header -->
		<header class="bg-zinc-950 py-32 md:py-48 border-b border-zinc-900 relative overflow-hidden">
			<div class="absolute inset-0">
				<img src="/cantrell-auto-detailing/images/interior-banner.jpg" alt="Interior Detail" class="w-full h-full object-cover object-center opacity-30" />
				<div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-transparent to-zinc-950"></div>
				<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-zinc-950/50"></div>
			</div>
			
			<div class="relative max-w-7xl mx-auto px-6 text-center">
				<span class="text-blue-500 font-bold tracking-[0.3em] uppercase text-xs mb-6 block">Total Cabin Rejuvenation</span>
				<h1 class="text-5xl md:text-8xl font-black text-white mb-8 uppercase tracking-tighter leading-[0.9] flex flex-col items-center min-h-[1.8em] md:min-h-[1.8em]">
					<span id="typewriter-line-1"></span>
					<span class="text-blue-600 italic" id="typewriter-line-2"></span>
				</h1>
				<p class="reveal max-w-2xl mx-auto text-zinc-300 text-lg md:text-xl opacity-0 transition-opacity duration-1000 font-medium">
					From daily drivers to luxury show cars, we provide deep-cleaning services that restore your vehicle's interior to its original showroom condition.
				</p>
			</div>
		</header>

		<!-- Service Detail -->
		<section class="reveal py-24 bg-white opacity-0 transition-opacity duration-1000">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
					<div class="space-y-8">
						<div>
							<h2 class="text-3xl font-black text-zinc-950 uppercase tracking-tight mb-6">Deep Clean & Condition</h2>
							<p class="text-zinc-600 text-lg leading-relaxed mb-6">
								Our interior detailing isn't just a quick vacuum. We perform a surgical-level cleaning of every surface, from the headliner to the floor mats. We use pH-balanced chemicals that effectively remove stains and odors without damaging delicate leather or upholstery.
							</p>
							<p class="text-zinc-600 text-lg leading-relaxed">
								Regular interior maintenance protects your investment and ensures a healthier environment for you and your passengers. Whether you're dealing with pet hair, coffee spills, or years of dust, we have the tools and expertise to fix it.
							</p>
						</div>

						<div class="bg-zinc-50 p-8 border-l-4 border-blue-600">
							<h3 class="font-bold text-zinc-950 mb-6 uppercase tracking-widest text-sm">What's Included:</h3>
							<ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-zinc-600">
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-blue-600 rounded-full"></span> 
									<span>Steam Cleaning & Sanitization</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-blue-600 rounded-full"></span> 
									<span>Hot Water Extraction (Carpets)</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-blue-600 rounded-full"></span> 
									<span>Leather Cleaning & Conditioning</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-blue-600 rounded-full"></span> 
									<span>Dashboard & Console Detailing</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-blue-600 rounded-full"></span> 
									<span>Headliner & Visor Cleaning</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-blue-600 rounded-full"></span> 
									<span>Odor Removal & Deodorizing</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-blue-600 rounded-full"></span> 
									<span>Door Jamb Cleaning</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-blue-600 rounded-full"></span> 
									<span>Streak-Free Glass Cleaning</span>
								</li>
							</ul>
						</div>
					</div>

					<div class="grid grid-cols-1 gap-6">
						<img src="/cantrell-auto-detailing/images/interior-vacuum.jpg" alt="Interior Detailing Service" class="w-full aspect-square object-cover shadow-2xl transition-all duration-700" />
						<div class="bg-zinc-950 p-8 text-white">
							<h3 class="text-2xl font-black uppercase mb-4">Request a Quote</h3>
							<p class="opacity-70 mb-6">Price varies based on vehicle size and condition. Contact us for a precise quote.</p>
							<a href="tel:864-414-4888" class="inline-block px-8 py-3 bg-blue-600 text-white font-bold uppercase hover:bg-blue-500 transition-colors">Book Now</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Interior Gallery -->
		<section class="reveal py-24 bg-zinc-950 opacity-0 transition-opacity duration-1000">
			<div class="max-w-7xl mx-auto px-6">
				<div class="flex flex-col gap-12">
					{[1, 2, 3].map((num) => (
						<div class="w-full">
							<img 
								src={`/cantrell-auto-detailing/images/gallery/i${num}.jpg`} 
								alt={`Interior Gallery ${num}`} 
								class="w-full h-auto shadow-2xl border border-white/5 transition-all duration-700"
							/>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="reveal py-24 bg-blue-600 opacity-0 transition-opacity duration-1000">
			<div class="max-w-4xl mx-auto px-6 text-center">
				<h2 class="text-3xl md:text-5xl font-black text-white mb-8 uppercase tracking-tighter">Ready to Restore Your Interior?</h2>
				<a href="tel:864-414-4888" class="inline-block px-10 py-5 bg-zinc-950 text-white font-black text-xl hover:bg-white hover:text-zinc-950 transition-all shadow-2xl">
					Call 864-414-4888
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	// Typewriter Animation
	const line1Text = "Interior";
	const line2Text = "Detailing";
	
	const el1 = document.getElementById('typewriter-line-1');
	const el2 = document.getElementById('typewriter-line-2');

	async function typeEffect(element, text, delay = 50) {
		element.classList.add('typing');
		for (let i = 0; i <= text.length; i++) {
			element.textContent = text.slice(0, i);
			await new Promise(resolve => setTimeout(resolve, delay));
		}
		element.classList.remove('typing');
	}

	window.addEventListener('DOMContentLoaded', async () => {
		await typeEffect(el1, line1Text, 70);
		await typeEffect(el2, line2Text, 90);
		
		// Initial reveal for elements in view
		document.querySelectorAll('.reveal').forEach(el => {
			const rect = el.getBoundingClientRect();
			if (rect.top < window.innerHeight) {
				el.classList.add('active');
			}
		});
	});

	// Scroll Reveal
	const observerOptions = { 
		threshold: 0.1,
		rootMargin: '0px 0px -100px 0px'
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('active');
			}
		});
	}, observerOptions);

	document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

<style>
	.reveal[data-direction="left"] {
		transform: translateX(-100px);
	}
	.reveal[data-direction="right"] {
		transform: translateX(100px);
	}
	.reveal.active {
		opacity: 1 !important;
		transform: translate(0, 0) !important;
	}
	.typing::after {
		content: '|';
		animation: blink 1s step-end infinite;
		margin-left: 4px;
		color: #3b82f6;
	}
	@keyframes blink {
		from, to { opacity: 1; }
		50% { opacity: 0; }
	}
</style>
