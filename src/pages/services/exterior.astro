---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="Exterior Detailing & Ceramic Coating | Cantrell Auto Detailing">
	<Header />
	<main>
		<!-- Page Header -->
		<header class="bg-zinc-950 py-24 border-b border-zinc-900 relative overflow-hidden">
			<div class="absolute inset-0 opacity-20">
				<img src="/cantrell-auto-detailing/images/Resized_20260214_110851.jpeg" alt="Exterior Detail" class="w-full h-full object-cover" />
			</div>
			<div class="relative max-w-7xl mx-auto px-6 text-center">
				<span class="text-blue-500 font-bold tracking-[0.3em] uppercase text-xs mb-4 block">Superior Shine & Protection</span>
				<h1 class="text-4xl md:text-6xl font-black text-white mb-6 uppercase tracking-tight">Exterior <span class="text-blue-600">Mastery</span></h1>
				<p class="text-zinc-400 text-lg max-w-2xl mx-auto">
					Premium paint protection and correction services designed to protect your vehicle from the elements and deliver a deep, mirror-like finish.
				</p>
			</div>
		</header>

		<!-- Service Detail -->
		<section class="py-24 bg-white">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
					<div class="space-y-8">
						<div>
							<h2 class="text-3xl font-black text-zinc-950 uppercase tracking-tight mb-6">Paint Correction & Protection</h2>
							<p class="text-zinc-600 text-lg leading-relaxed mb-6">
								We don't just wash cars; we restore paint. Our multi-stage process removes swirl marks, oxidation, and light scratches to reveal the true depth of your vehicle's color. Whether you need a simple wax or a permanent ceramic solution, we have you covered.
							</p>
							<p class="text-zinc-600 text-lg leading-relaxed">
								Environmental factors like UV rays, acid rain, and road salt constantly attack your clear coat. Our professional-grade coatings provide a sacrificial layer that makes your car easier to clean and harder to damage.
							</p>
						</div>

						<div class="bg-zinc-50 p-8 border-l-4 border-zinc-950">
							<h3 class="font-bold text-zinc-950 mb-6 uppercase tracking-widest text-sm">Professional Exterior Services:</h3>
							<ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-zinc-600">
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span class="font-bold text-zinc-950">Ceramic Coating (Premium)</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Multi-Stage Paint Correction</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Clay Bar Surface Decontamination</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Machine Buffing & High-Gloss Wax</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Headlight Restoration</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Wheel & Rim Polishing</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Undercarriage Degreasing</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Trim & Plastic Restoration</span>
								</li>
							</ul>
						</div>
					</div>

					<div class="grid grid-cols-1 gap-6">
						<img src="/cantrell-auto-detailing/images/Resized_20260214_110851.jpeg" alt="Exterior Paint Perfection" class="w-full aspect-square object-cover shadow-2xl hover:scale-[1.02] transition-transform duration-700" />
						<div class="bg-zinc-950 p-8 text-white">
							<h3 class="text-2xl font-black uppercase mb-4">Starting at $100</h3>
							<p class="opacity-70 mb-6">Price varies by vehicle size and selected protection level (Wax vs. Ceramic). Call for details.</p>
							<a href="tel:864-414-4888" class="inline-block px-8 py-3 bg-blue-600 text-white font-bold uppercase hover:bg-blue-500 transition-colors">Free Estimate</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="py-24 bg-blue-600">
			<div class="max-w-4xl mx-auto px-6 text-center">
				<h2 class="text-3xl md:text-5xl font-black text-white mb-8 uppercase tracking-tighter">Bring Back the Showroom Shine</h2>
				<a href="tel:864-414-4888" class="inline-block px-10 py-5 bg-zinc-950 text-white font-black text-xl hover:bg-white hover:text-zinc-950 transition-all shadow-2xl">
					Call 864-414-4888
				</a>
			</div>
		</section>
	</main>

	<footer class="bg-zinc-950 py-12 border-t border-zinc-900">
		<div class="max-w-7xl mx-auto px-6 text-center">
			<img src="/cantrell-auto-detailing/images/logo-white.png" alt="Cantrell Auto Detailing Logo" class="h-12 w-auto mx-auto mb-6 opacity-40 hover:opacity-100 transition-all duration-500" />
			<p class="text-zinc-500 text-sm italic">© 2026 Cantrell Auto Detailing. All Rights Reserved.</p>
		</div>
	</footer>
</Layout>
