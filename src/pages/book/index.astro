---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const services = [
  { id: 'exterior', label: 'Exterior Detailing', category: 'Service' },
  { id: 'interior', label: 'Interior Detailing', category: 'Service' }
];

const categories = [...new Set(services.map(s => s.category))];
---

<Layout title="Book an Appointment | Cantrell Auto Detailing">
	<Header />
	<main class="bg-zinc-50 pt-32 pb-24 min-h-screen">
		<div class="max-w-4xl mx-auto px-6">
			<div class="text-center mb-16">
				<h1 class="text-5xl md:text-6xl font-black uppercase tracking-tighter text-zinc-950 mb-4">Request a Quote</h1>
				<p class="text-zinc-600 text-lg max-w-2xl mx-auto italic">Ready to transform your vehicle? Fill out the form below and we'll get back to you within 24 hours with a personalized quote.</p>
			</div>

			<form action="https://submit-form.com/3ExGFOgjJ" method="POST" class="bg-white p-8 md:p-12 shadow-2xl rounded-3xl border border-zinc-100">
				<!-- Formspark Configuration -->
				<input type="hidden" name="_subject" value="New Quote Request: Cantrell Auto Detailing" />
				<input type="hidden" name="_template" value="table" />
				
				<div class="grid md:grid-cols-2 gap-8 mb-12">
					<div class="flex flex-col gap-2">
						<label for="name" class="text-xs font-black uppercase tracking-widest text-zinc-400">Full Name</label>
						<input 
							type="text" 
							id="name" 
							name="name" 
							required 
							placeholder="John Doe"
							class="w-full px-5 py-4 bg-zinc-50 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 transition-all font-medium"
						/>
					</div>
					<div class="flex flex-col gap-2">
						<label for="phone" class="text-xs font-black uppercase tracking-widest text-zinc-400">Phone Number</label>
						<input 
							type="tel" 
							id="phone" 
							name="phone" 
							required 
							placeholder="(864) 000-0000"
							class="w-full px-5 py-4 bg-zinc-50 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 transition-all font-medium"
						/>
					</div>
					<div class="flex flex-col gap-2 md:col-span-2">
						<label for="email" class="text-xs font-black uppercase tracking-widest text-zinc-400">Email Address</label>
						<input 
							type="email" 
							id="email" 
							name="email" 
							required 
							placeholder="john@example.com"
							class="w-full px-5 py-4 bg-zinc-50 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 transition-all font-medium"
						/>
					</div>
				</div>

				<div class="mb-12">
					<label class="text-xs font-black uppercase tracking-widest text-zinc-400 block mb-6">Select Services (Select all that apply)</label>
					<div class="grid sm:grid-cols-2 gap-4">
						{services.map((service) => (
							<label class="group relative flex items-center p-4 bg-zinc-50 border border-zinc-200 rounded-2xl cursor-pointer hover:border-blue-600 hover:bg-blue-50 transition-all">
								<input 
									type="checkbox" 
									name="services[]" 
									value={service.label}
									class="w-5 h-5 rounded border-zinc-300 text-blue-600 focus:ring-blue-600 mr-4"
								/>
								<div class="flex flex-col">
									<span class="text-xs font-black uppercase tracking-tighter text-zinc-400 group-hover:text-blue-400">{service.category}</span>
									<span class="font-bold text-zinc-900 group-hover:text-blue-700">{service.label}</span>
								</div>
							</label>
						))}
					</div>
				</div>

				<div class="flex flex-col gap-2 mb-12">
					<label for="note" class="text-xs font-black uppercase tracking-widest text-zinc-400">Additional Notes (Vehicle Make/Model, special requests, etc.)</label>
					<textarea 
						id="note" 
						name="note" 
						rows="4" 
						placeholder="I have a black SUV that needs a deep interior clean..."
						class="w-full px-5 py-4 bg-zinc-50 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 transition-all font-medium"
					></textarea>
				</div>

				<button 
					type="submit" 
					class="w-full py-6 bg-zinc-950 text-white rounded-2xl text-xl font-black uppercase tracking-[0.2em] hover:bg-blue-600 hover:shadow-2xl hover:shadow-blue-600/30 transition-all transform active:scale-[0.98]"
				>
					Send Quote Request
				</button>
			</form>

			<div class="mt-16 grid md:grid-cols-3 gap-8 text-center">
				<div>
					<span class="block text-blue-600 text-2xl mb-2">📍</span>
					<h3 class="font-black uppercase text-sm tracking-widest text-zinc-950">Service Area</h3>
					<p class="text-zinc-500">Taylors, SC & Surrounding</p>
				</div>
				<div>
					<span class="block text-blue-600 text-2xl mb-2">📞</span>
					<h3 class="font-black uppercase text-sm tracking-widest text-zinc-950">Call/Text</h3>
					<p class="text-zinc-500">864-414-4888</p>
				</div>
				<div>
					<span class="block text-blue-600 text-2xl mb-2">📸</span>
					<h3 class="font-black uppercase text-sm tracking-widest text-zinc-950">Follow Us</h3>
					<p class="text-zinc-500">@CantrellAutoDetailing</p>
				</div>
			</div>
		</div>
	</main>
</Layout>
