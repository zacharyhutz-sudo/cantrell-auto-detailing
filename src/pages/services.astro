---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Services | Cantrell Auto Detailing">
	<Header />
	<main>

		<!-- Page Header -->
		<header class="bg-zinc-950 py-24 border-b border-zinc-900">
			<div class="max-w-7xl mx-auto px-6 text-center">
				<h1 class="text-4xl md:text-6xl font-black text-white mb-6 uppercase tracking-tight">Professional <span class="text-blue-600">Services</span></h1>
				<p class="text-zinc-400 text-lg max-w-2xl mx-auto">
					Over 20 years of expertise in Taylors, SC. We offer specialized care for every square inch of your vehicle.
				</p>
			</div>
		</header>

		<!-- Service Grid -->
		<section class="py-24 bg-white">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<!-- Exterior Hub -->
					<div class="group relative overflow-hidden bg-zinc-950 aspect-[16/10]">
						<img src="/cantrell-auto-detailing/images/Resized_20260214_110851.jpeg" alt="Exterior Services" class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:scale-110 transition-transform duration-700" />
						<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
						<div class="absolute bottom-0 left-0 p-8">
							<h2 class="text-3xl font-black text-white uppercase mb-4">Exterior & Ceramic</h2>
							<p class="text-zinc-300 mb-6 max-w-sm">Paint correction, ceramic coatings, and high-performance protection.</p>
							<a href="/cantrell-auto-detailing/services/exterior/" class="inline-flex items-center gap-2 text-blue-400 font-bold uppercase tracking-widest text-sm hover:text-blue-300 transition-colors">
								Learn More
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
								</svg>
							</a>
						</div>
					</div>

					<!-- Interior Hub -->
					<div class="group relative overflow-hidden bg-zinc-950 aspect-[16/10]">
						<img src="/cantrell-auto-detailing/images/Resized_20260214_105756.jpeg" alt="Interior Services" class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:scale-110 transition-transform duration-700" />
						<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
						<div class="absolute bottom-0 left-0 p-8">
							<h2 class="text-3xl font-black text-white uppercase mb-4">Interior Detailing</h2>
							<p class="text-zinc-300 mb-6 max-w-sm">Deep cleaning, odor removal, and leather conditioning for a like-new cabin.</p>
							<a href="/cantrell-auto-detailing/services/interior/" class="inline-flex items-center gap-2 text-blue-400 font-bold uppercase tracking-widest text-sm hover:text-blue-300 transition-colors">
								Learn More
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
								</svg>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Call to Action -->
		<section class="py-24 bg-blue-600">
			<div class="max-w-4xl mx-auto px-6 text-center">
				<h2 class="text-3xl md:text-5xl font-extrabold text-white mb-8">Ready to Restore Your Ride?</h2>
				<p class="text-blue-100 text-lg mb-10">
					Call us today for a free estimate and experience the difference of 17+ years of expertise.
				</p>
				<a href="tel:864-414-4888" class="inline-block px-10 py-5 bg-zinc-950 text-white font-extrabold text-xl hover:bg-white hover:text-blue-600 transition-all shadow-2xl">
					Call 864-414-4888
				</a>
			</div>
		</section>
	</main>

	<footer class="bg-zinc-950 py-12 border-t border-zinc-900">
		<div class="max-w-7xl mx-auto px-6 text-center">
			<p class="text-zinc-500 text-sm">© 2026 Cantrell Auto Detailing. All Rights Reserved.</p>
		</div>
	</footer>
</Layout>
