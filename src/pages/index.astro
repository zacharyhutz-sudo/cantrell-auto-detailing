---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { reviews } from '../data/reviews';

const featuredReviews = reviews.slice(0, 5);
---

<Layout title="Cantrell Auto Detailing | Taylors, SC">
	<Header />
	<main>

		<!-- Hero Section -->
		<section class="relative py-24 md:py-32 overflow-hidden bg-zinc-950 min-h-[80vh] flex items-center mb-0">
			<div class="absolute inset-0 opacity-25">
				<img src="/cantrell-auto-detailing/images/Resized_20260214_110851.jpeg" alt="Detailed Purple Hummer" class="w-full h-full object-cover" />
				<div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/20 to-transparent via-[30%] md:via-[50%] to-[50%] md:to-[70%]"></div>
			</div>
			<div class="relative max-w-7xl mx-auto px-6 text-left w-full">
				<h1 id="hero-title" class="text-4xl md:text-7xl font-extrabold text-white tracking-tight mb-8 leading-[1.0] max-w-none uppercase min-h-[3em] md:min-h-[auto] flex flex-col items-start">
					<span class="md:whitespace-nowrap" id="typewriter-line-1"></span>
					<span id="typewriter-line-2"></span>
					<span class="text-blue-500 italic" id="typewriter-line-3"></span>
				</h1>
				<p class="reveal max-w-xl text-zinc-300 text-lg md:text-xl mb-12 leading-relaxed opacity-0 transition-all duration-1000 translate-y-4">
					Professional auto detailing services specializing in paint correction, ceramic coatings, and interior restoration. We bring the showroom shine back to your vehicle.
				</p>
				<div class="reveal flex flex-col sm:flex-row items-center justify-start gap-4 opacity-0 transition-all duration-1000 translate-y-4 delay-300">
					<a href="tel:864-414-4888" class="w-full sm:w-auto px-8 py-4 bg-blue-600 text-white font-bold hover:bg-blue-500 hover:scale-105 transition-all shadow-lg shadow-blue-600/20 text-center">
						Call 864-414-4888
					</a>
					<a href="/cantrell-auto-detailing/services/" class="w-full sm:w-auto px-8 py-4 bg-zinc-800 text-white font-bold hover:bg-zinc-700 transition-all text-center">
						View Services
					</a>
				</div>
			</div>
		</section>

		<!-- Testimonial Scroller -->
		<section class="reveal bg-blue-600 py-20 overflow-hidden border-y border-blue-500/30 opacity-0 transition-all duration-1000 translate-y-0 mt-0 relative z-10">
			<div class="flex whitespace-nowrap animate-scroll hover:[animation-play-state:paused]">
				{[...Array(2)].map(() => (
					<div class="flex gap-24 items-center px-12">
						{featuredReviews.map((review) => (
							<div class="inline-flex flex-col items-center gap-6 text-white max-w-lg text-center whitespace-normal">
								<div class="flex flex-col items-center gap-2">
									<div class="flex text-yellow-300">
										{[...Array(review.stars)].map(() => (
											<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
												<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
											</svg>
										))}
									</div>
									<span class="text-sm font-bold uppercase tracking-[0.3em] opacity-90">
										{review.firstName} {review.lastInitial}.
									</span>
								</div>
								
								<p class="text-base md:text-xl font-medium leading-relaxed max-w-md">
									"{review.text}"
								</p>
							</div>
						))}
					</div>
				))}
			</div>
		</section>

		<!-- Info Bar -->
		<section class="reveal py-12 bg-white border-b border-zinc-200 opacity-0 transition-all duration-1000 translate-y-0">
			<div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12">
				<div class="flex flex-col items-center text-center">
					<div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
					</div>
					<h3 class="font-bold text-zinc-950 mb-1">Visit Us</h3>
					<p class="text-sm text-zinc-600">3016 Wade Hampton Blvd<br/>Taylors, SC 29687</p>
				</div>
				<div class="flex flex-col items-center text-center border-y md:border-y-0 md:border-x border-zinc-100 py-8 md:py-0">
					<div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<h3 class="font-bold text-zinc-950 mb-1">Open Hours</h3>
					<p class="text-sm text-zinc-600">Mon - Fri: 7am - 5pm<br/>Sat - Sun: Closed</p>
				</div>
				<div class="flex flex-col items-center text-center">
					<div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
						</svg>
					</div>
					<h3 class="font-bold text-zinc-950 mb-1">Contact Info</h3>
					<p class="text-sm text-zinc-600">864-414-4888<br/>captnhuk.gc@gmail.com</p>
				</div>
			</div>
		</section>

		<!-- Brands Section -->
		<section class="reveal py-16 bg-zinc-50 opacity-0 transition-all duration-1000 translate-y-0">
			<div class="max-w-7xl mx-auto px-6">
				<p class="text-center text-xs font-bold text-zinc-400 uppercase tracking-widest mb-10">We Use Professional Grade Products</p>
				<div class="flex flex-wrap items-center justify-center gap-12 grayscale opacity-50">
					<span class="text-2xl font-black italic tracking-tighter text-zinc-950">MEGUIAR'S</span>
					<span class="text-3xl font-bold tracking-tighter text-zinc-950">3M</span>
					<span class="text-2xl font-extrabold text-zinc-950">F11 TOPCOAT</span>
					<span class="text-2xl font-medium tracking-widest text-zinc-950 uppercase">Sealtek</span>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	// Typewriter Animation
	const isMobile = window.innerWidth < 768;
	const line1Text = "Precision";
	const line2Text = "Detailing";
	const line3Text = "Mastered.";
	
	const el1 = document.getElementById('typewriter-line-1');
	const el2 = document.getElementById('typewriter-line-2');
	const el3 = document.getElementById('typewriter-line-3');

	async function typeEffect(element, text, delay = 50) {
		element.classList.add('typing');
		for (let i = 0; i <= text.length; i++) {
			element.textContent = text.slice(0, i);
			await new Promise(resolve => setTimeout(resolve, delay));
		}
		element.classList.remove('typing');
	}

	window.addEventListener('DOMContentLoaded', async () => {
		if (isMobile) {
			// Mobile: Precision | Detailing | Mastered (3 lines)
			await typeEffect(el1, "Precision", 60);
			await typeEffect(el2, "Detailing", 60);
			await typeEffect(el3, "Mastered.", 80);
		} else {
			// Desktop: Precision Detailing | Mastered (2 lines)
			await typeEffect(el1, "Precision Detailing", 60);
			await typeEffect(el3, "Mastered.", 80);
		}
		
		// Trigger initial reveals in hero after typing
		document.querySelectorAll('.reveal').forEach(el => {
			const rect = el.getBoundingClientRect();
			if (rect.top < window.innerHeight) {
				el.classList.add('active');
			}
		});
	});

	// Scroll Reveal
	const observerOptions = {
		threshold: 0.1,
		rootMargin: '0px 0px -50px 0px'
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('active');
			}
		});
	}, observerOptions);

	document.querySelectorAll('.reveal').forEach(el => {
		observer.observe(el);
	});
</script>

<style>
	@keyframes scroll {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}
	.animate-scroll {
		animation: scroll 80s linear infinite;
		width: max-content;
	}
	
	.reveal.active {
		opacity: 1 !important;
		transform: translateY(0) !important;
	}

	.reveal:not(.active) {
		pointer-events: none;
	}

	/* Typewriter cursor effect */
	.typing::after {
		content: '|';
		animation: blink 1s step-end infinite;
		margin-left: 4px;
		color: #3b82f6;
	}

	@keyframes blink {
		from, to { opacity: 1; }
		50% { opacity: 0; }
	}
</style>
