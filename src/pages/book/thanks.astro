---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Thank You | Cantrell's Auto Detailing">
	<Header />
	<main class="pt-32 pb-24 min-h-[80vh] flex items-center bg-zinc-50 relative overflow-hidden">
		<!-- Decorative Background Glow -->
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl aspect-square bg-blue-600/5 rounded-full blur-[120px]"></div>
		
		<div class="max-w-4xl mx-auto px-6 text-center relative z-10">
			<div class="inline-flex items-center justify-center w-24 h-24 bg-blue-600 text-white rounded-full mb-12 shadow-2xl shadow-blue-600/30">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
				</svg>
			</div>
			
			<h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter text-zinc-950 mb-6">Request <span class="text-blue-600 italic">Received.</span></h1>
			<p class="text-zinc-600 text-lg md:text-xl max-w-xl mx-auto mb-12 font-medium">
				Thank you for choosing Cantrell's. We've received your request and our team will be in touch within 24 hours to finalize your quote.
			</p>
			
			<div class="flex flex-col sm:flex-row gap-6 justify-center">
				<a href="/cantrell-auto-detailing/" class="px-12 py-5 bg-zinc-950 text-white font-black uppercase tracking-widest hover:bg-blue-600 transition-all shadow-xl">
					Back to Home
				</a>
				<a href="tel:864-414-4888" class="px-12 py-5 bg-white border border-zinc-200 text-zinc-950 font-black uppercase tracking-widest hover:bg-zinc-50 transition-all">
					Call 864-414-4888
				</a>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
