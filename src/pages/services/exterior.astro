---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Exterior Detailing & Ceramic Coating | Cantrell Auto Detailing">
	<Header />
	<main>
		<!-- Page Header -->
		<header class="bg-zinc-950 py-32 md:py-48 border-b border-zinc-900 relative overflow-hidden">
			<div class="absolute inset-0">
				<img src="/cantrell-auto-detailing/images/exterior.jpg" alt="Exterior Detail" class="w-full h-full object-cover object-center opacity-30" />
				{/* Stronger linear gradients to ensure text readability and focus on center */}
				<div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-transparent to-zinc-950"></div>
				<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-zinc-950/50"></div>
			</div>
			
			<div class="relative max-w-7xl mx-auto px-6 text-center">
				<span class="text-blue-500 font-bold tracking-[0.3em] uppercase text-xs mb-6 block">Superior Shine & Protection</span>
				<h1 class="text-5xl md:text-8xl font-black text-white mb-8 uppercase tracking-tighter leading-[0.9] flex flex-col items-center">
					<span id="typewriter-line-1"></span>
					<span class="text-blue-600 italic" id="typewriter-line-2"></span>
				</h1>
				<p class="reveal max-w-2xl mx-auto text-zinc-300 text-lg md:text-xl opacity-0 transition-opacity duration-1000 font-medium">
					Premium paint protection and correction services designed to protect your vehicle from the elements and deliver a deep, mirror-like finish.
				</p>
			</div>
		</header>

		<!-- Service Detail -->
		<section class="reveal py-24 bg-white opacity-0 transition-opacity duration-1000">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
					<div class="space-y-8">
						<div>
							<h2 class="text-3xl font-black text-zinc-950 uppercase tracking-tight mb-6">Paint Correction & Protection</h2>
							<p class="text-zinc-600 text-lg leading-relaxed mb-6">
								We don't just wash cars; we restore paint. Our multi-stage process removes swirl marks, oxidation, and light scratches to reveal the true depth of your vehicle's color. Whether you need a simple wash or a permanent ceramic solution, we have you covered.
							</p>
							<p class="text-zinc-600 text-lg leading-relaxed">
								Environmental factors like UV rays, acid rain, and road salt constantly attack your clear coat. Our professional-grade coatings provide a sacrificial layer that makes your car easier to clean and harder to damage.
							</p>
						</div>

						<div class="bg-zinc-50 p-8 border-l-4 border-zinc-950">
							<h3 class="font-bold text-zinc-950 mb-6 uppercase tracking-widest text-sm">Professional Exterior Services:</h3>
							<ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-zinc-600">
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span class="font-bold text-zinc-950">Ceramic Coating (Premium)</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Multi-Stage Paint Correction</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Clay Bar Surface Decontamination</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Machine Buffing & High-Gloss Wax</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Headlight Restoration</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Wheel & Rim Polishing</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Undercarriage Degreasing</span>
								</li>
								<li class="flex items-center gap-3">
									<span class="w-2 h-2 bg-zinc-950 rounded-full"></span> 
									<span>Trim & Plastic Restoration</span>
								</li>
							</ul>
						</div>
					</div>

					<div class="grid grid-cols-1 gap-6">
						<img src="/cantrell-auto-detailing/images/Resized_20260214_110851.jpeg" alt="Exterior Paint Perfection" class="w-full aspect-square object-cover shadow-2xl hover:scale-[1.02] transition-transform duration-700" />
						<div class="bg-zinc-950 p-8 text-white">
							<h3 class="text-2xl font-black uppercase mb-4">Request a Quote</h3>
							<p class="opacity-70 mb-6">Price varies by vehicle size and selected protection level (Wax vs. Ceramic). Call for details.</p>
							<a href="tel:864-414-4888" class="inline-block px-8 py-3 bg-blue-600 text-white font-bold uppercase hover:bg-blue-500 transition-colors">Free Estimate</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Before & After Gallery -->
		<section class="reveal-section py-24 bg-zinc-950 overflow-x-hidden">
			<div class="max-w-7xl mx-auto px-6">
				<div class="text-center mb-16">
					<span class="text-blue-500 font-bold tracking-[0.3em] uppercase text-xs mb-4 block">The Proof is in the Process</span>
					<h2 class="text-3xl md:text-5xl font-black text-white uppercase tracking-tight">Before & After Gallery</h2>
				</div>

				<div class="space-y-24">
					{[1, 2, 3, 4].map((num, index) => (
						<div 
							class="reveal opacity-0 transition-all duration-1000 flex flex-col items-center gap-8"
							data-direction={index % 2 === 0 ? 'left' : 'right'}
						>
							<div class="flex flex-col md:flex-row gap-4 w-full justify-center">
								{/* Before */}
								<div class="relative w-full md:w-1/2 aspect-square overflow-hidden shadow-2xl border border-white/5">
									<img 
										src={`/cantrell-auto-detailing/images/gallery/e${num}b.JPEG`} 
										alt={`Exterior ${num} Before`} 
										class="w-full h-full object-cover grayscale-[0.3]"
									/>
									<div class="absolute top-4 left-4 bg-zinc-950/80 text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 border border-white/10">Before</div>
								</div>
								{/* After */}
								<div class="relative w-full md:w-1/2 aspect-square overflow-hidden shadow-2xl border border-white/5">
									<img 
										src={`/cantrell-auto-detailing/images/gallery/e${num}a.JPEG`} 
										alt={`Exterior ${num} After`} 
										class="w-full h-full object-cover"
									/>
									<div class="absolute top-4 right-4 bg-blue-600/90 text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1">After</div>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="reveal py-24 bg-blue-600 opacity-0 transition-opacity duration-1000">
			<div class="max-w-4xl mx-auto px-6 text-center">
				<h2 class="text-3xl md:text-5xl font-black text-white mb-8 uppercase tracking-tighter">Bring Back the Showroom Shine</h2>
				<a href="tel:864-414-4888" class="inline-block px-10 py-5 bg-zinc-950 text-white font-black text-xl hover:bg-white hover:text-zinc-950 transition-all shadow-2xl">
					Call 864-414-4888
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	// Typewriter Animation
	const line1Text = "Exterior";
	const line2Text = "Mastery";
	
	const el1 = document.getElementById('typewriter-line-1');
	const el2 = document.getElementById('typewriter-line-2');

	async function typeEffect(element, text, delay = 50) {
		element.classList.add('typing');
		for (let i = 0; i <= text.length; i++) {
			element.textContent = text.slice(0, i);
			await new Promise(resolve => setTimeout(resolve, delay));
		}
		element.classList.remove('typing');
	}

	window.addEventListener('DOMContentLoaded', async () => {
		await typeEffect(el1, line1Text, 70);
		await typeEffect(el2, line2Text, 90);
		
		// Initial reveal for elements in view
		document.querySelectorAll('.reveal').forEach(el => {
			const rect = el.getBoundingClientRect();
			if (rect.top < window.innerHeight) {
				el.classList.add('active');
			}
		});
	});

	// Scroll Reveal
	const observerOptions = { 
		threshold: 0.1,
		rootMargin: '0px 0px -100px 0px'
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('active');
			}
		});
	}, observerOptions);

	document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

<style>
	.reveal[data-direction="left"] {
		transform: translateX(-100px);
	}
	.reveal[data-direction="right"] {
		transform: translateX(100px);
	}
	.reveal.active {
		opacity: 1 !important;
		transform: translate(0, 0) !important;
	}
	.typing::after {
		content: '|';
		animation: blink 1s step-end infinite;
		margin-left: 4px;
		color: #3b82f6;
	}
	@keyframes blink {
		from, to { opacity: 1; }
		50% { opacity: 0; }
	}
</style>
