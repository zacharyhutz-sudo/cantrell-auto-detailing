---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { reviews } from '../data/reviews';
---

<Layout title="Testimonials | Cantrell Auto Detailing">
	<Header />
	<main class="pt-32 pb-24 bg-zinc-50">
		<div class="max-w-7xl mx-auto px-6">
			<div class="mb-16 text-center">
				<h1 class="text-4xl md:text-6xl font-extrabold text-zinc-950 mb-4 tracking-tight">Customer Reviews</h1>
				<p class="text-zinc-600 text-lg max-w-2xl mx-auto">
					See why our clients trust Cantrell Auto Detailing for their premium vehicle care.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{reviews.map((review) => (
					<div class="bg-white p-8 rounded-2xl border border-zinc-200 shadow-sm flex flex-col justify-between">
						<div>
							<div class="flex text-yellow-400 mb-4">
								{[...Array(review.stars)].map(() => (
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
										<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
									</svg>
								))}
							</div>
							<p class="text-zinc-700 italic leading-relaxed mb-6">"{review.fullText || review.text}"</p>
						</div>
						<div class="border-t border-zinc-100 pt-6 mt-auto">
							<p class="font-bold text-zinc-900">{review.firstName} {review.lastInitial}.</p>
							<p class="text-xs text-zinc-400 uppercase tracking-widest mt-1">Verified Client</p>
						</div>
					</div>
				))}
			</div>

			<div class="mt-20 bg-zinc-950 rounded-3xl p-12 text-center text-white overflow-hidden relative">
				<div class="relative z-10">
					<h2 class="text-3xl font-bold mb-4">Ready to see the results yourself?</h2>
					<p class="text-zinc-400 mb-8 max-w-xl mx-auto">Join our list of satisfied customers and give your vehicle the premium care it deserves.</p>
					<a href="tel:864-414-4888" class="inline-block px-10 py-4 bg-blue-600 text-white font-bold hover:bg-blue-500 transition-all rounded-full">
						Book Your Detail Today
					</a>
				</div>
				<div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/4 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl"></div>
			</div>
		</div>
	</main>
</Layout>
