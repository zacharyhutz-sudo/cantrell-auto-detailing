---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cantrell Auto Detailing | Taylors, SC">
	<main>
		<!-- Navigation -->
		<nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-zinc-200">
			<div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
				<a href="/" class="flex items-center overflow-hidden">
					<img src="/cantrell-auto-detailing/images/logo.png" alt="Cantrell Auto Detailing Logo" class="h-24 w-auto scale-150 object-center" />
				</a>
				<div class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-600">
					<a href="#services" class="hover:text-blue-600 transition-colors">Services</a>
					<a href="#about" class="hover:text-blue-600 transition-colors">About</a>
					<a href="#contact" class="px-5 py-2.5 bg-zinc-950 text-white rounded-full hover:bg-blue-600 transition-all">Book Now</a>
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="relative py-24 md:py-32 overflow-hidden bg-zinc-950">
			<div class="absolute inset-0 opacity-25">
				<img src="/cantrell-auto-detailing/images/Resized_20260214_110851.jpeg" alt="Detailed Purple Hummer" class="w-full h-full object-cover" />
				<div class="absolute inset-0 bg-gradient-to-r from-zinc-950/40 via-zinc-950/20 to-transparent"></div>
			</div>
			<div class="relative max-w-7xl mx-auto px-6 text-left">
				<span class="inline-block py-1 px-3 bg-blue-500/10 text-blue-400 text-xs font-bold tracking-widest uppercase mb-6 border border-blue-500/20">
					Premium Car Care in Taylors, SC
				</span>
				<h1 class="text-5xl md:text-7xl font-extrabold text-white tracking-tight mb-8 leading-[1.1] max-w-3xl">
					Precision Detailing <br/><span class="text-blue-500">Mastered.</span>
				</h1>
				<p class="max-w-xl text-zinc-300 text-lg md:text-xl mb-12 leading-relaxed">
					Professional auto detailing services specializing in paint correction, ceramic coatings, and interior restoration. We bring the showroom shine back to your vehicle.
				</p>
				<div class="flex flex-col sm:flex-row items-center justify-start gap-4">
					<a href="tel:864-414-4888" class="w-full sm:w-auto px-8 py-4 bg-blue-600 text-white font-bold hover:bg-blue-500 hover:scale-105 transition-all shadow-lg shadow-blue-600/20 text-center">
						Call 864-414-4888
					</a>
					<a href="#services" class="w-full sm:w-auto px-8 py-4 bg-zinc-800 text-white font-bold hover:bg-zinc-700 transition-all text-center">
						View Services
					</a>
				</div>
			</div>
		</section>

		<!-- Info Bar -->
		<section class="py-12 bg-white border-b border-zinc-200">
			<div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12">
				<div class="flex flex-col items-center text-center">
					<div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
					</div>
					<h3 class="font-bold text-zinc-950 mb-1">Visit Us</h3>
					<p class="text-sm text-zinc-600">3016 Wade Hampton Blvd<br/>Taylors, SC 29687</p>
				</div>
				<div class="flex flex-col items-center text-center border-y md:border-y-0 md:border-x border-zinc-100 py-8 md:py-0">
					<div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<h3 class="font-bold text-zinc-950 mb-1">Open Hours</h3>
					<p class="text-sm text-zinc-600">Mon - Fri: 7am - 5pm<br/>Sat - Sun: Closed</p>
				</div>
				<div class="flex flex-col items-center text-center">
					<div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
						</svg>
					</div>
					<h3 class="font-bold text-zinc-950 mb-1">Contact Info</h3>
					<p class="text-sm text-zinc-600">864-414-4888<br/>captnhuk.gc@gmail.com</p>
				</div>
			</div>
		</section>

		<!-- Brands Section -->
		<section class="py-16 bg-zinc-50">
			<div class="max-w-7xl mx-auto px-6">
				<p class="text-center text-xs font-bold text-zinc-400 uppercase tracking-widest mb-10">We Use Professional Grade Products</p>
				<div class="flex flex-wrap items-center justify-center gap-12 grayscale opacity-50">
					<span class="text-2xl font-black italic tracking-tighter text-zinc-950">MEGUIAR'S</span>
					<span class="text-3xl font-bold tracking-tighter text-zinc-950">3M</span>
					<span class="text-2xl font-extrabold text-zinc-950">F11 TOPCOAT</span>
					<span class="text-2xl font-medium tracking-widest text-zinc-950 uppercase">Sealtek</span>
				</div>
			</div>
		</section>
	</main>

	<footer class="bg-zinc-950 py-12 border-t border-zinc-900">
		<div class="max-w-7xl mx-auto px-6 text-center">
			<p class="text-zinc-500 text-sm">© 2026 Cantrell Auto Detailing. All Rights Reserved.</p>
		</div>
	</footer>
</Layout>
